# Copy to .env and fill in. Only ONE gold price provider is needed; others are backups.
# If the first provider fails or runs out of credits, the next one with a key is used.
TWELVE_DATA_API_KEY=e44bc24f55d84c8499aa3df37c745d22
MASSIVE_API_KEY=uyePVog3Y3mOWC_rxlaPlgp357W8Yrt5
# Keys are read by serve.mjs on the server and are never sent to the browser.
GOLDAPI_KEY=
METALPRICE_API_KEY=
METALS_DEV_API_KEY=
METALS_API_KEY=
# Only needed for PKR if your metals provider doesn't return it (AED uses the 3.6725 peg)
EXCHANGERATE_API_KEY=
# twelvedata | massive | goldapi | metalpriceapi | metalsdev | metalsapi
GOLD_PROVIDER=twelvedata
# USD | AED | PKR
DEFAULT_CURRENCY=USD
# 300 keeps Twelve Data free plan under 800 credits/day
REFRESH_INTERVAL_SECONDS=300
# Bid/Ask: percentage below spot you buy at, and above spot you sell at
BUY_MARGIN_PCT=0.5
SELL_MARGIN_PCT=0.5
# Watch market values (average price per reference) — provider to be chosen
WATCH_PRICE_PROVIDER=
WATCH_PRICE_API_KEY=
