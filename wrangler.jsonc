// Cloudflare Worker configuration (used by `npx wrangler deploy`).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alizeh-bullion-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // The built website (npm run build). Files here are served directly; other paths go to the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Keep the API keys and settings entered in the dashboard (Settings → Variables and Secrets)
  // instead of wiping them on each deploy.
  "keep_vars": true

  // Optional credit-saving store for live rates. After creating a KV namespace in the dashboard,
  // add its id here (the id is not secret):
  // ,"kv_namespaces": [{ "binding": "RATES_KV", "id": "PASTE_NAMESPACE_ID" }]
}
